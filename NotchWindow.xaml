<Window x:Class="WinNotch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch" Width="460" Height="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- Кнопки плеера: векторные значки (не зависят от шрифтов и не обрезаются), при нажатии «проседают» -->
        <Style x:Key="Ctl" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="24" Width="64" Height="48"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Корпус. Размер задаётся из кода пружинной физикой. В режиме «Mac» по бокам видны «ушки» -->
        <Grid x:Name="Notch" Width="122" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
              MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave" MouseWheel="Notch_MouseWheel">

            <Path x:Name="EarL" Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,0,0,0" Visibility="Collapsed"
                  Data="M 0,0 L 10.5,0 L 10.5,10 L 10,10 A 10,10 0 0 0 0,0 Z"/>
            <Path x:Name="EarR" Fill="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-10,0" Visibility="Collapsed"
                  Data="M 10.5,0 L 0,0 L 0,10 L 0.5,10 A 10,10 0 0 1 10.5,0 Z"/>

            <Border x:Name="Shell" Background="Black" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="17">
                <Grid>
                    <!-- Свёрнутый вид: мини-обложка слева, эквалайзер справа -->
                    <Grid x:Name="TopBar" Height="34" VerticalAlignment="Top">
                        <Border x:Name="MiniArt" Width="20" Height="20" CornerRadius="6" HorizontalAlignment="Left"
                                Margin="14,0,0,0" Visibility="Collapsed" Background="#FF2C2C2E">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,16,0" Visibility="Collapsed">
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#E6FFFFFF" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Sc1" ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#E6FFFFFF" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Sc2" ScaleY="0.5"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#E6FFFFFF" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Sc3" ScaleY="0.4"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>

                    <!-- Раскрытое содержимое. Высота корпуса считается по реальному размеру содержимого — ничего не обрезается -->
                    <Grid x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Top" Width="336" Margin="0,18,0,0"
                          Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Плеер -->
                        <Grid x:Name="MediaPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="12" Background="#FF1C1C1E">
                                    <Grid>
                                        <Path Fill="#55FFFFFF" Stretch="Uniform" Width="20" Height="22"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M 6,0 L 20,0 L 20,15 A 4,4 0 1 1 16,11 L 16,5 L 10,6 L 10,17 A 4,4 0 1 1 6,13 Z"/>
                                        <Border CornerRadius="12">
                                            <Border.Background>
                                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Display, Segoe UI" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ArtistText" Foreground="#99FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="EqBig" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                    <Rectangle Width="3.5" Height="20" RadiusX="1.75" RadiusY="1.75" Fill="#E6FFFFFF" Margin="0,0,3,0" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="Sb1" ScaleY="0.35"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="3.5" Height="20" RadiusX="1.75" RadiusY="1.75" Fill="#E6FFFFFF" Margin="0,0,3,0" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="Sb2" ScaleY="0.6"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="3.5" Height="20" RadiusX="1.75" RadiusY="1.75" Fill="#E6FFFFFF" Margin="0,0,3,0" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="Sb3" ScaleY="0.45"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="3.5" Height="20" RadiusX="1.75" RadiusY="1.75" Fill="#E6FFFFFF" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="Sb4" ScaleY="0.3"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                </StackPanel>
                            </Grid>

                            <!-- Полоска прогресса -->
                            <Border x:Name="Track" Grid.Row="1" Margin="0,14,0,0" Height="18" Background="Transparent" Cursor="Hand"
                                    MouseEnter="Track_Enter" MouseLeave="Track_Leave"
                                    MouseLeftButtonDown="Track_Down" MouseMove="Track_Move"
                                    MouseLeftButtonUp="Track_Up" LostMouseCapture="Track_Lost">
                                <Grid x:Name="TrackLine" VerticalAlignment="Center" Height="5">
                                    <Border Background="#33FFFFFF" CornerRadius="4"/>
                                    <Border x:Name="Fill" Background="White" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </Border>

                            <!-- Время под полоской, как в iOS -->
                            <Grid Grid.Row="2" Margin="0,0,0,0">
                                <TextBlock x:Name="TimeCur" Foreground="#80FFFFFF" FontSize="11" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TimeTotal" Foreground="#80FFFFFF" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Style="{StaticResource Ctl}" Click="Prev_Click">
                                    <Path Fill="White" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"
                                          Width="28" Height="20" Data="M 25,1 L 15,9 L 25,17 Z M 11,1 L 1,9 L 11,17 Z"/>
                                </Button>
                                <Button Style="{StaticResource Ctl}" Click="Play_Click" Margin="10,0">
                                    <Grid>
                                        <Path x:Name="PlayShape" Fill="White" Stroke="White" StrokeThickness="2.5" StrokeLineJoin="Round" Stretch="Uniform"
                                              Width="26" Height="30" Data="M 2,1 L 22,13 L 2,25 Z"/>
                                        <Path x:Name="PauseShape" Fill="White" Stroke="White" StrokeThickness="2.5" StrokeLineJoin="Round" Stretch="Uniform"
                                              Width="26" Height="30" Visibility="Collapsed" Data="M 2,1 H 8 V 25 H 2 Z M 14,1 H 20 V 25 H 14 Z"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource Ctl}" Click="Next_Click">
                                    <Path Fill="White" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"
                                          Width="28" Height="20" Data="M 1,1 L 11,9 L 1,17 Z M 15,1 L 25,9 L 15,17 Z"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Время / дата / батарея (когда музыки нет) -->
                        <Grid x:Name="InfoPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClockText" FontSize="54" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="DayText" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                <TextBlock x:Name="DateText" FontSize="13" Foreground="#99FFFFFF" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <TextBlock x:Name="BatteryText" FontSize="12" Foreground="#B3FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <Grid Width="28" Height="13" VerticalAlignment="Center">
                                        <Border Background="#33FFFFFF" CornerRadius="4" Margin="0,0,2.5,0"/>
                                        <Border x:Name="BatFill" Background="White" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,0" Width="12"/>
                                        <Border Width="2" Height="5" Background="#55FFFFFF" HorizontalAlignment="Right" CornerRadius="0,1.5,1.5,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Уведомление (клик — закрыть) -->
                        <Grid x:Name="NotifPanel" Visibility="Collapsed" Background="Transparent" MouseLeftButtonUp="Notif_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NotifBadge" Width="44" Height="44" CornerRadius="11" Background="#FF2C2C2E" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock x:Name="NotifInitial" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="NotifIcon" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NotifApp" FontSize="11" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NotifTitle" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NotifBody" FontSize="13" Foreground="#CCFFFFFF" TextWrapping="Wrap"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
